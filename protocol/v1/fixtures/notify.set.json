{
  "description": "Mute this machine and turn the reminder off; idleSeconds keeps its default.",
  "setup": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
        "protocol": 1,
        "client": {
          "name": "togo-test",
          "version": "0.0.0-test"
        },
        "capabilities": []
      }
    }
  ],
  "request": {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "notify.set",
    "params": {
      "muted": true,
      "remindMinutes": 0
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 2,
    "result": {
      "idleSeconds": 6,
      "muted": true,
      "remindMinutes": 0
    }
  }
}
