{
  "description": "A name containing a control character (newline) is rejected; no session is created. reason is human-readable text.",
  "setup": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
        "protocol": 1,
        "client": {
          "name": "togo-test",
          "version": "0.0.0-test"
        },
        "capabilities": []
      }
    }
  ],
  "request": {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "session.create",
    "params": {
      "agent": "shell",
      "cwd": "~/proj",
      "name": "a\nb"
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 2,
    "error": {
      "code": -32602,
      "message": "invalid params",
      "data": {
        "reason": "<any>"
      }
    }
  }
}
