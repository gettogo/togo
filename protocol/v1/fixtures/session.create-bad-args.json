{
  "description": "An args entry containing a NUL byte is rejected with reason args; no session is created and nothing runs. Harness deviation: the login-shell PATH holds an executable claude that waits at its prompt until killed.",
  "setup": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
        "protocol": 1,
        "client": {
          "name": "togo-test",
          "version": "0.0.0-test"
        },
        "capabilities": []
      }
    }
  ],
  "request": {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "session.create",
    "params": {
      "agent": "claude",
      "cwd": "~/proj",
      "args": [
        "--model",
        "a\u0000b"
      ]
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 2,
    "error": {
      "code": -32602,
      "message": "invalid params",
      "data": {
        "reason": "args"
      }
    }
  }
}
