{
  "description": "A relative path is rejected even when it exists under the home directory.",
  "setup": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
        "protocol": 1,
        "client": {
          "name": "togo-test",
          "version": "0.0.0-test"
        },
        "capabilities": []
      }
    }
  ],
  "request": {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "fs.listDir",
    "params": {
      "path": "proj"
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 2,
    "error": {
      "code": -32003,
      "message": "invalid_path"
    }
  }
}
