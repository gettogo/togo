      "name": "Claude Code",
      "agent": "claude",
      "cwd": "<home>/proj",
      "createdAt": "2026-11-03T12:00:00Z",
      "status": "idle",
      "activity": null,
      "attachedClients": 0,
      "managed": true,
      "muted": false,
      "meta": {
        "model": null,
        "contextPercent": null,
        "costUsd": null
      },
      "command": [
        "claude"
      ],
      "exit": null
    }
  }
