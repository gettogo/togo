{
  "description": "harness.open on a session no adapter serves is refused; the app keeps the terminal.",
  "setup": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
        "protocol": 1,
        "client": {
          "name": "togo-test",
          "version": "0.0.0-test"
        },
        "capabilities": []
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "session.create",
      "params": {
        "agent": "shell",
        "cwd": "~/proj"
      }
    }
  ],
  "request": {
    "jsonrpc": "2.0",
    "id": 3,
    "method": "harness.open",
    "params": {
      "id": "s_abcdefghij"
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 3,
    "error": {
      "code": -32008,
      "message": "refused",
      "data": {
        "reason": "no_adapter"
      }
    }
  }
}
