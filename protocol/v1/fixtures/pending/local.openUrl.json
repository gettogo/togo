{
  "description": "The open shim of session s_abcdefghij hands a sign-in page to the helper, which publishes browser.open because an app is subscribed. Harness deviation: an app is attached in the foreground.",
  "setup": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
        "protocol": 1,
        "client": {
          "name": "togo-test",
          "version": "0.0.0-test"
        },
        "capabilities": []
      }
    }
  ],
  "request": {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "local.openUrl",
    "params": {
      "sessionId": "s_abcdefghij",
      "url": "http://localhost:54545/login?next=%2F"
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 2,
    "result": {
      "delivered": true
    }
  }
}
