{
  "description": "Only http and https URLs open on the machine; a file URL is refused and nothing runs. Harness deviation: the opener is a fake that fails the test if called.",
  "setup": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
        "protocol": 1,
        "client": {
          "name": "togo-test",
          "version": "0.0.0-test"
        },
        "capabilities": []
      }
    }
  ],
  "request": {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "browser.openOnMac",
    "params": {
      "url": "file:///etc/passwd"
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 2,
    "error": {
      "code": -32602,
      "message": "invalid params",
      "data": {
        "reason": "<any>"
      }
    }
  }
}
