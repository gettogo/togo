{
  "description": "A session whose cwd is not inside a git repository.",
  "setup": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
        "protocol": 1,
        "client": {
          "name": "togo-test",
          "version": "0.0.0-test"
        },
        "capabilities": []
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "session.create",
      "params": {
        "agent": "shell",
        "cwd": "~/proj"
      }
    }
  ],
  "request": {
    "jsonrpc": "2.0",
    "id": 3,
    "method": "git.status",
    "params": {
      "id": "s_abcdefghij"
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 3,
    "result": {
      "repo": false,
      "root": null,
      "branch": null,
      "ahead": 0,
      "behind": 0,
      "files": []
    }
  }
}
