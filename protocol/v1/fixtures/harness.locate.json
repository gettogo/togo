{
  "description": "An anchor still in history resolves to its distance from the bottom of the pane. Harness deviation: a fake `claude` on PATH prints version 2.1.319 and idles; the claude adapter's transcript feed reads testdata/claude/transcript-basic.jsonl, and the anchor marker reports epoch \"e1\" with fixed offsets.",
  "setup": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
        "protocol": 1,
        "client": {
          "name": "togo-test",
          "version": "0.0.0-test"
        },
        "capabilities": []
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "session.create",
      "params": {
        "agent": "claude",
        "cwd": "~/proj"
      }
    }
  ],
  "request": {
    "jsonrpc": "2.0",
    "id": 3,
    "method": "harness.locate",
    "params": {
      "id": "s_abcdefghij",
      "anchor": {
        "epoch": "e1",
        "bytes": 2210,
        "line": 19,
        "needle": "Bash(go test ./internal/clock/...)"
      }
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 3,
    "result": {
      "found": true,
      "linesFromBottom": 33,
      "needle": "Bash(go test ./internal/clock/...)"
    }
  }
}
