{
  "description": "Reading a file relative to a session whose cwd is HOME; notes.txt holds the single byte x.",
  "setup": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
        "protocol": 1,
        "client": {
          "name": "togo-test",
          "version": "0.0.0-test"
        },
        "capabilities": []
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "session.create",
      "params": {
        "agent": "shell",
        "cwd": "~"
      }
    }
  ],
  "request": {
    "jsonrpc": "2.0",
    "id": 3,
    "method": "fs.read",
    "params": {
      "id": "s_abcdefghij",
      "path": "notes.txt"
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 3,
    "result": {
      "path": "notes.txt",
      "size": 1,
      "encoding": "utf8",
      "content": "x",
      "truncated": false
    }
  }
}
