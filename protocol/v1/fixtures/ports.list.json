{
  "description": "A fresh shell session listens on no ports.",
  "setup": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
        "protocol": 1,
        "client": {
          "name": "togo-test",
          "version": "0.0.0-test"
        },
        "capabilities": []
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "session.create",
      "params": {
        "agent": "shell",
        "cwd": "~/proj"
      }
    }
  ],
  "request": {
    "jsonrpc": "2.0",
    "id": 3,
    "method": "ports.list",
    "params": {
      "id": "s_abcdefghij"
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 3,
    "result": {
      "ports": []
    }
  }
}
