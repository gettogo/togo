{
  "name": "togo-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Default environment: a workers.dev sandbox for development and for
  // self-hosting. Use `--env production` for the custom-domain deployment.
  "workers_dev": true,
  "routes": [{ "pattern": "relay.togoapp.dev", "custom_domain": true }],
  // Logs never hold tokens or ciphertext.
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    // Bundle id of the iOS app; APNs rejects pushes whose topic differs.
    "APNS_TOPIC": "app.togo.Togo"
  },
  // Secrets, set with `wrangler secret put`, never in this file:
  //   APNS_KEY      APNs auth key (.p8 contents)
  //   APNS_KEY_ID   10-character key id
  //   APNS_TEAM_ID  10-character team id
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "MAILBOX", "class_name": "Mailbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter", "Mailbox"] }
  ],
  // Production serves only from the custom domain. Environments do not inherit
  // bindings, vars or migrations, so they are repeated here. Self-hosters set
  // their own domain (or drop this block and use the default environment).
  "env": {
    "production": {
      "workers_dev": false,
      "routes": [{ "pattern": "relay.togoapp.dev", "custom_domain": true }],
      "observability": { "enabled": true, "head_sampling_rate": 0.1 },
      "vars": { "APNS_TOPIC": "app.togo.Togo" },
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
          { "name": "MAILBOX", "class_name": "Mailbox" }
        ]
      }
    }
  }
}
