                ],
                "label": [
                  {
                    "t": "Report: dump session"
                  }
                ]
              }
            },
            {
              "id": "1e.list/memory",
              "k": "item",
              "p": {
                "detail": [
                  {
                    "s": "muted",
                    "t": "Memory statistics + bundle"
                  }
                ],
                "label": [
                  {
                    "t": "Report: memory issue"
                  }
                ]
              }
            },
            {
              "id": "1e.list/logs",
              "k": "item",
              "p": {
                "detail": [
                  {
                    "s": "muted",
                    "t": "Show last 50 log entries"
                  }
                ],
                "label": [
                  {
                    "t": "View: recent logs"
                  }
                ]
              }
            },
            {
              "id": "1e.list/system",
              "k": "item",
              "p": {
                "detail": [
                  {
                    "s": "muted",
                    "t": "Show environment details"
                  }
                ],
                "label": [
                  {
                    "t": "View: system info"
                  }
                ]
              }
            },
            {
              "id": "1e.list/terminal",
              "k": "item",
              "p": {
                "detail": [
                  {
                    "s": "muted",
                    "t": "Subprotocols, geometry, scrollback strategy"
                  }
                ],
                "label": [
                  {
                    "t": "View: terminal state"
                  }
                ]
              }
            },
            {
              "id": "1e.list/protocols",
              "k": "item",
              "p": {
                "detail": [
                  {
                    "s": "muted",
                    "t": "Styling, links, text sizing, graphics, notify"
                  }
                ],
                "label": [
                  {
                    "t": "Test: terminal protocols"
                  }
                ]
              }
            },
            {
              "id": "1e.list/raw-sse",
              "k": "item",
              "p": {
                "detail": [
