{
  "id": "1c",
  "k": "card",
  "p": {
    "head": "Debug Tools",
    "role": "omp.overlay"
  },
  "c": [
    {
      "id": "1d",
      "k": "spacer",
      "p": {
        "size": "sm"
      }
    },
    {
      "id": "1e",
      "k": "col",
      "p": {
        "role": "omp.select"
      },
      "c": [
        {
          "id": "1e.list",
          "k": "list",
          "p": {
            "empty": "No items",
            "max": {
              "lines": 7
            },
            "selected": "1e.list/open-artifacts"
          },
          "c": [
            {
              "id": "1e.list/open-artifacts",
              "k": "item",
              "p": {
                "detail": [
                  {
                    "s": "muted",
                    "t": "Open session artifacts in file manager"
                  }
                ],
                "label": [
                  {
                    "t": "Open: artifact folder"
                  }
                ]
              }
            },
            {
              "id": "1e.list/performance",
              "k": "item",
              "p": {
                "detail": [
                  {
                    "s": "muted",
                    "t": "Profile CPU, reproduce, then bundle"
                  }
                ],
                "label": [
                  {
                    "t": "Report: performance issue"
                  }
                ]
              }
            },
            {
              "id": "1e.list/work",
              "k": "item",
              "p": {
                "detail": [
                  {
                    "s": "muted",
                    "t": "Open flamegraph of last 30s"
                  }
                ],
                "label": [
                  {
                    "t": "Profile: work scheduling"
                  }
                ]
              }
            },
            {
              "id": "1e.list/dump",
              "k": "item",
              "p": {
                "detail": [
                  {
                    "s": "muted",
                    "t": "Create report bundle immediately"
