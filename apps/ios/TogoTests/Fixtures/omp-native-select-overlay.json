            {
              "id": "1e.list/transcript",
              "k": "item",
              "p": {
                "detail": [
                  {
                    "s": "muted",
                    "t": "Write visible TUI conversation to a temp txt"
                  }
                ],
                "label": [
                  {
                    "t": "Export: TUI transcript"
                  }
                ]
              }
            },
            {
              "id": "1e.list/clear-cache",
              "k": "item",
              "p": {
                "detail": [
                  {
                    "s": "muted",
                    "t": "Remove old session artifacts"
                  }
                ],
                "label": [
                  {
                    "t": "Clear: artifact cache"
