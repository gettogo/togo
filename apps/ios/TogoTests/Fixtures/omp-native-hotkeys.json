                      "keys": [
                        {
                          "s": "key",
                          "t": "shift+enter"
                        },
                        {
                          "s": "dim",
                          "t": " "
                        },
                        {
                          "s": "key",
                          "t": "alt+enter"
                        }
                      ]
                    },
                    "id": "1"
                  },
                  {
                    "cells": {
                      "action": [
                        {
                          "t": "Delete word backwards"
                        }
