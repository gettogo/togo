TE_LABEL[s.status]}</span>\n42:         </div>\n43:         <ol class=\"bar\" aria-label=\"Uptime, last ${s.uptime.length} days\">${days}</ol>\n44:         <div class=\"bar-legend\">\n45:           <span>${s.uptime.length} days ago</span>\n46:           <span class=\"pct\">${averageUptime(s.uptime).toFixed(2)}% uptime</span>\n47:           <span>Today</span>\n48:         </div>\n49:       </li>`;\n50: }\n51: \n52: export function renderPage(data: StatusData): string {\n53:   const state = overallState(data.services);\n54:   const updated = new Date(data.updated).toLocaleString(\"en-GB\", {\n55:     day: \"numeric\", month: \"short\", hour: \"2-digit\", minute: \"2-digit\", timeZone: \"UTC\",\n56:   });\n57:   return `<!doctype html>\n58: <html lang=\"en\">\n59: <head>\n60:   <meta charset=\"utf-8\">\n61:   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n62:   <title>Status</title>\n63:   <link rel=\"stylesheet\" href=\"/style.css\">\n64: </head>\n65: <body>\n66:   <main>\n67:     <header>\n68:       <p class=\"eyebrow\">Status</p>\n69:       <div class=\"banner ${state}\">\n70:         <span class=\"dot\"></span>\n71:         <div>\n72:           <strong>${BANNER[state]}</strong>\n73:           <span>Updated ${updated} UTC</span>\n74:         </div>\n75:       </div>\n76:     </header>\n77:     <section aria-label=\"Services\">\n78:       <ul class=\"services\">${data.services.map((s) => renderService(s, data.since)).join(\"\")}\n79:       </ul>\n80:     </section>\n81:   </main>\n82: </body>\n83: </html>\n84: `;\n85: }","startedAt":"2026-11-09T13:57:02.949Z","state":"ok","subject":{"kind":"file","text":"src/render.ts"},"title":"Read render.ts"},"turnId":"turn-msg_1c098fc65001qgMZbDNnPZwXXi"}],"kind":"items","sessionId":"s_b4zhctffop","ts":"2026-11-09T08:57:03.00207-05:00"}}
