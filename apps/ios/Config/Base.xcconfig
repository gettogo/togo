// Shared by every target. Target-specific values live in project.yml.
#include "Signing.xcconfig"

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
CODE_SIGN_STYLE = Automatic

// The hosted relay's host name, without https://. It names a personal
// account, so it stays out of git: copy Relay.example.xcconfig to
// Relay.xcconfig and fill it in. Without it the app pairs only with a
// relay set in Settings > Notifications.
TOGO_RELAY_HOST =
#include? "Relay.xcconfig"
